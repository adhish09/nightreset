# ---------------------------------------------------------------------------
# Supabase
# Find these in your Supabase project: Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only. Bypasses Row Level Security.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# OpenAI
# Server-only — the browser never calls OpenAI directly.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Any chat-completions-capable model that supports structured JSON outputs,
# e.g. gpt-4.1-mini, gpt-4o-mini, or a newer equivalent.
OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Razorpay
# Key ID + secret from Razorpay Dashboard -> Settings -> API Keys.
# Webhook secret is set separately when you add the webhook endpoint under
# Dashboard -> Settings -> Webhooks (see README for the URL to use).
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Safe to expose to the browser — used by Razorpay Checkout on the client.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---------------------------------------------------------------------------
# PostHog (analytics)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ---------------------------------------------------------------------------
# App
# Used for absolute URLs in metadata (Open Graph, etc). Set to your deployed
# domain in production, e.g. https://nightreset.app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
