# ---------------------------------------------------------------------------
# Supabase
# Find these in your Supabase project: Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only. Bypasses Row Level Security.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# OpenAI (or any OpenAI-compatible provider)
# Server-only — the browser never calls this API directly.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Any chat-completions-capable model that supports structured JSON outputs,
# e.g. gpt-4.1-mini, gpt-4o-mini, or a newer equivalent.
OPENAI_MODEL=
# Optional. Leave unset to call api.openai.com. Set this to use a different
# OpenAI-compatible provider instead, e.g. Groq's free tier:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-20b
# (get a free key at https://console.groq.com/keys — check the Limits page
# in your Groq console for which models are covered by the free plan)
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Razorpay
# Key ID + secret from Razorpay Dashboard -> Settings -> API Keys.
# Webhook secret is set separately when you add the webhook endpoint under
# Dashboard -> Settings -> Webhooks (see README for the URL to use).
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Safe to expose to the browser — used by Razorpay Checkout on the client.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---------------------------------------------------------------------------
# PostHog (analytics)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ---------------------------------------------------------------------------
# App
# Used for absolute URLs in metadata (Open Graph, etc). Set to your deployed
# domain in production, e.g. https://nightreset.app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional launch-day switch. Set to "false" to give every signed-in user
# unlimited free resets (no paywall) while validating demand — the payment
# code paths are untouched, so setting this back to "true" (or removing it)
# restores the real 1-free-then-pay-₹79 flow with no other changes needed.
PAYWALL_ENABLED=true
